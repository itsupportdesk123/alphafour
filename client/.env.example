# Base URL of the Aurelia API.
# Development: leave as /api (Vite proxies it to API_PROXY_TARGET).
# Production (e.g. Vercel): https://your-api.onrender.com/api
VITE_API_URL=/api

# Public URL of this website (canonical links, Open Graph, sitemap)
VITE_SITE_URL=https://itsupportdesk123.github.io/alphafour

# WhatsApp number for the floating button (country code, digits only)
VITE_WHATSAPP_NUMBER=919800000000

# Hero mode: auto | webgl | static   (auto = WebGL on capable devices, static poster otherwise)
VITE_HERO_MODE=auto

# Hero 3D quality: auto | low | medium | high   (auto adapts to the device and frame rate)
VITE_HERO_QUALITY=auto

# AlphaFour intro film on entry: session (once per browser tab) | always | once (first visit only) | off
# Add ?intro=1 to any URL to force it (handy for testing) or ?intro=0 to skip it.
VITE_INTRO_MODE=session

# Dev only: where `npm run dev` forwards /api requests
API_PROXY_TARGET=http://localhost:4083

# Optional map tiles (default: OpenStreetMap). Use a keyed provider for production traffic, e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
