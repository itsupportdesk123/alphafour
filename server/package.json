{
  "name": "aurelia-server",
  "version": "1.0.0",
  "private": true,
  "description": "Aurelia Residences API: enquiry, feedback and newsletter mail service (Express, controller → service → repository)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "nodemailer": "^6.10.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0"
  }
}
