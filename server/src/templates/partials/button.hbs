<table role="presentation" cellpadding="0" cellspacing="0" style="display:inline-table;margin:10px 10px 0 0;">
  <tr>
    <td bgcolor="{{#if secondary}}#FFFDF7{{else}}#C9A24B{{/if}}" style="border-radius:999px;{{#if secondary}}border:1px solid #C9A24B;{{else}}background:#C9A24B;background-image:linear-gradient(135deg,#B8892F 0%,#F3DFA2 50%,#B8892F 100%);{{/if}}">
      <a href="{{href}}" style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:14px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#0B1630;text-decoration:none;">{{label}}</a>
    </td>
  </tr>
</table>
