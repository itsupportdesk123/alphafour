{{#if rows.length}}
{{#if caption}}
<p style="margin:26px 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:2px;text-transform:uppercase;color:#866526;">{{caption}}</p>
{{/if}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:{{#if caption}}0 0 24px{{else}}24px 0{{/if}};border:1px solid #E9DFC9;border-radius:14px;border-collapse:separate;overflow:hidden;">
  {{#each rows}}
  <tr class="stack">
    <td style="padding:13px 18px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:2px;text-transform:uppercase;color:#866526;width:38%;vertical-align:top;{{#unless @last}}border-bottom:1px solid #F0E8D6;{{/unless}}">{{label}}</td>
    <td style="padding:13px 18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#1C1C1E;vertical-align:top;word-break:break-word;{{#unless @last}}border-bottom:1px solid #F0E8D6;{{/unless}}">{{#if muted}}<span style="color:#6B6253;font-style:italic;">{{value}}</span>{{else if href}}<a href="{{href}}" style="color:#1E3A8A;">{{value}}</a>{{else}}{{value}}{{/if}}</td>
  </tr>
  {{/each}}
</table>
{{/if}}
