<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:3px;text-transform:uppercase;color:#866526;">{{eyebrow}}</p>
<h1 class="h1" style="margin:12px 0 0;font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:32px;line-height:38px;color:#0B1630;">{{heading}}</h1>
{{#if reference}}
<p style="margin:16px 0 0;"><span style="display:inline-block;padding:6px 14px;border-radius:999px;background:#F5EFE0;border:1px solid #E6D3A3;font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:2px;color:#0B1630;">REF&nbsp;&nbsp;{{reference}}</span></p>
{{/if}}
