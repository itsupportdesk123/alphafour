{{#if text}}
<p style="margin:26px 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:2px;text-transform:uppercase;color:#866526;">{{#if caption}}{{caption}}{{else}}Message{{/if}}</p>
<div style="margin:0 0 24px;padding:18px 20px;background:#F5EFE0;border-left:3px solid #C9A24B;border-radius:8px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#1C1C1E;">{{nl2br text}}</div>
{{/if}}
