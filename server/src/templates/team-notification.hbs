{{> heading eyebrow=eyebrow heading=heading reference=reference}}
<p style="margin:16px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#4A4438;">{{intro}}</p>

{{> details rows=details caption="Submission details"}}

{{> message text=message caption=messageLabel}}

{{#if actions.length}}
<div style="margin:4px 0 0;">
  {{#each actions}}{{> button this}}{{/each}}
</div>
{{/if}}

<p style="margin:30px 0 0;padding-top:18px;border-top:1px solid #F0E8D6;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6B6253;">
  Received {{submittedAt}}{{#if source}} &middot; Page: <strong>{{source}}</strong>{{/if}}<br>
  Request ID: {{requestId}}
</p>
