<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{title}}</title>
  <style>
    body { margin: 0; padding: 0; background: #F5EFE0; -webkit-text-size-adjust: 100%; }
    table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
    a { color: #1E3A8A; }
    @media (max-width: 620px) {
      .container { width: 100% !important; }
      .px { padding-left: 24px !important; padding-right: 24px !important; }
      .h1 { font-size: 28px !important; line-height: 34px !important; }
      .stack, .stack td { display: block !important; width: 100% !important; box-sizing: border-box !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#F5EFE0;">
  <div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;">{{preheader}}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#F5EFE0" style="background:#F5EFE0;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;">
          <tr>
            <td class="px" align="center" bgcolor="#1E3A8A" style="background:#1E3A8A;background-image:linear-gradient(160deg,#0B1630 0%,#1E3A8A 100%);border-radius:20px 20px 0 0;padding:38px 40px 32px;">
              <div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:34px;letter-spacing:10px;color:#C9A24B;">ALPHAFOUR</div>
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:14px;letter-spacing:6px;color:#E6D3A3;text-transform:uppercase;margin-top:8px;">Infrastructure Pvt Ltd</div>
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px auto 0;">
                <tr>
                  <td style="width:56px;height:1px;background:#C9A24B;font-size:0;line-height:0;">&nbsp;</td>
                  <td style="padding:0 10px;font-family:Georgia,serif;font-size:12px;color:#C9A24B;line-height:12px;">&#9670;</td>
                  <td style="width:56px;height:1px;background:#C9A24B;font-size:0;line-height:0;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td class="px" bgcolor="#FFFDF7" style="background:#FFFDF7;padding:40px 44px 44px;border-left:1px solid #E9DFC9;border-right:1px solid #E9DFC9;">
              {{{body}}}
            </td>
          </tr>
          <tr>
            <td class="px" align="center" bgcolor="#0B1630" style="background:#0B1630;border-radius:0 0 20px 20px;padding:30px 40px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;color:#E6D3A3;">
              <div style="color:#C9A24B;letter-spacing:4px;text-transform:uppercase;font-size:11px;">{{brand.name}}</div>
              <div style="margin-top:10px;color:#E6D3A3;">{{brand.address}}</div>
              <div style="margin-top:6px;">
                <a href="tel:{{telHref brand.phone}}" style="color:#E6D3A3;text-decoration:none;">{{brand.phone}}</a>
                {{#if brand.phoneAlt}}
                &nbsp;&middot;&nbsp;
                <a href="tel:{{telHref brand.phoneAlt}}" style="color:#E6D3A3;text-decoration:none;">{{brand.phoneAlt}}</a>
                {{/if}}
                &nbsp;&middot;&nbsp;
                <a href="mailto:{{brand.email}}" style="color:#E6D3A3;text-decoration:none;">{{brand.email}}</a>
              </div>
              <div style="margin-top:6px;">
                <a href="{{brand.siteUrl}}" style="color:#C9A24B;">Visit our website</a>
                &nbsp;&middot;&nbsp;
                <a href="https://wa.me/{{brand.whatsapp}}" style="color:#C9A24B;">WhatsApp concierge</a>
              </div>
              <div style="margin-top:16px;color:#A79C88;font-size:11px;">&copy; {{year}} {{brand.name}}. All rights reserved.</div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
