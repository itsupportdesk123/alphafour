{{> heading eyebrow="Feedback received" heading=heading reference=reference}}
<p style="margin:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:25px;color:#4A4438;">
  Every note we receive is read by our leadership team. Your feedback helps us make every experience with Alphafour Infrastructure Pvt Ltd a little more exceptional.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0 0;border:1px solid #E9DFC9;border-radius:14px;border-collapse:separate;">
  <tr>
    <td align="center" style="padding:22px 20px;">
      <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#866526;">Your rating</p>
      <p style="margin:8px 0 0;font-family:Georgia,serif;font-size:30px;line-height:34px;letter-spacing:4px;color:#C9A24B;">{{stars rating}}</p>
      <p style="margin:6px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#6B6253;">{{rating}} out of 5 &middot; {{topicLabel}}</p>
    </td>
  </tr>
</table>

{{> details rows=details caption="Your submission details"}}

{{> message text=message caption="Your feedback"}}

{{#if lowRating}}
<p style="margin:22px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:25px;color:#4A4438;">
  We’re sorry we fell short. A senior member of our client experience team will reach out personally to make things right.
</p>
{{/if}}

<div style="margin:22px 0 0;">
  {{> button href=brand.siteUrl label="Return to Alphafour Infrastructure Pvt Ltd"}}
</div>

{{> signature brand=brand}}
