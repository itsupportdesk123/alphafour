# ─────────────────────────────────────────────────────────────────────────────
#  Alphafour Infrastructure Pvt Ltd API: copy to `.env` and fill in.  (Never commit .env)
#  This file IS committed: keep real passwords, app passwords and secrets out of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4083                       # the website's dev server proxies /api here (client API_PROXY_TARGET)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=1                   # hops of reverse proxies in front of the API (Render/Railway = 1)

# ── Website ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5200            # used for links inside emails (production: https://alpha4infra.com)
CORS_ORIGINS=http://localhost:5200          # comma-separated list of allowed browser origins

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200              # all API requests per IP per window
FORM_RATE_LIMIT_MAX=10          # form submissions per IP per window

# ── Mail: who receives what ──────────────────────────────────────────────────
# Every website form (enquiry, brochure, site visit, call-back, feedback, newsletter) sends:
#   1. an admin notification to MAIL_TEAM_TO (+ MAIL_TEAM_CC) listing every form field;
#      fields the visitor left blank read "Not provided";
#   2. a copy to the visitor's own email address with "Your submission details".
#      Call-back and feedback forms make the email optional; without one, only the admin is notified.
#
#   Testing (Gmail):         MAIL_TEAM_TO=it.support.enexio@gmail.com
#   Live (Microsoft 365):    MAIL_TEAM_TO=sales@alpha4infra.com    (see "Switching to Microsoft 365" below)

# ── Mail: common ─────────────────────────────────────────────────────────────
# console   = development: logs emails and writes previews to MAIL_PREVIEW_DIR (nothing is sent)
# smtp      = any SMTP server (Gmail, Zoho, Hostinger, Amazon SES, …)
# office365 = Microsoft 365 / Exchange Online (smtp.office365.com:587, STARTTLS)
# If empty: "smtp" when SMTP_HOST is set, otherwise "console".
MAIL_PROVIDER=console
MAIL_FROM_NAME=Alphafour Infrastructure Pvt Ltd
MAIL_FROM_ADDRESS=sales@alpha4infra.com             # sender: must be the mailbox you sign in with (Gmail: SMTP_USER)
MAIL_TEAM_TO=sales@alpha4infra.com                  # ADMIN inbox for every website submission (comma-separated)
MAIL_TEAM_CC=                                       # optional copies (comma-separated)
MAIL_REPLY_TO=sales@alpha4infra.com                 # where visitors' replies go
MAIL_VERIFY_ON_STARTUP=true                         # SMTP handshake on boot (warns, never crashes)
MAIL_PREVIEW_DIR=.mail-previews                     # console provider output folder

# ── Mail: generic SMTP (MAIL_PROVIDER=smtp) ──────────────────────────────────
# Gmail:     smtp.gmail.com     587  SMTP_SECURE=false  (App Password: Google Account → Security →
#            2-Step Verification → App passwords; set MAIL_FROM_ADDRESS to the same Gmail address)
# Zoho:      smtp.zoho.in       465  SMTP_SECURE=true
# Hostinger: smtp.hostinger.com 465  SMTP_SECURE=true
# SES:       email-smtp.ap-south-1.amazonaws.com 587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465 (implicit TLS); false for 587 (STARTTLS enforced)
SMTP_USER=
SMTP_PASS=                      # put the real value in .env only
SMTP_POOL=true

# ── Mail: Microsoft 365 (MAIL_PROVIDER=office365) ────────────────────────────
# password = SMTP AUTH with mailbox credentials (Basic auth, being retired by Microsoft)
# oauth2   = XOAUTH2 via an Entra ID app (client credentials). Recommended for the future.
MS365_AUTH=password
MS365_HOST=smtp.office365.com
MS365_PORT=587
# password mode
MS365_USER=
MS365_PASSWORD=
# oauth2 mode
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER=                   # mailbox the app sends as, e.g. sales@alpha4infra.com

# ── Switching to Microsoft 365 (sales@alpha4infra.com) ───────────────────────
# In .env, replace the Gmail test settings with:
#   MAIL_PROVIDER=office365
#   MAIL_FROM_ADDRESS=sales@alpha4infra.com
#   MAIL_TEAM_TO=sales@alpha4infra.com
#   MAIL_REPLY_TO=sales@alpha4infra.com
#   oauth2 (recommended, see README → Mail setup):
#     MS365_AUTH=oauth2, MS365_TENANT_ID, MS365_CLIENT_ID, MS365_CLIENT_SECRET, MS365_SENDER=sales@alpha4infra.com
#   or password (SMTP AUTH must be enabled for the mailbox):
#     MS365_AUTH=password, MS365_USER=sales@alpha4infra.com, MS365_PASSWORD
# Then clear or delete the SMTP_* lines, restart the API and check that GET /api/health shows "verified": true.
# On Render: make the same changes in the dashboard (render.yaml sets MAIL_PROVIDER=smtp; change it to office365).

# ── Brand details used inside emails ────────────────────────────────────────
BRAND_EMAIL=sales@alpha4infra.com               # public contact address in email footers (default: MAIL_FROM_ADDRESS)
BRAND_PHONE=+91 94443 14567
BRAND_PHONE_ALT=+91 94442 54567                 # optional second number
BRAND_WHATSAPP=919800000000                     # placeholder: replace with the real WhatsApp number (country code + digits)
BRAND_ADDRESS=Dadha Chambers, 5th & 7th Floor, New No: 250, Old No: 268, V.P. Raman Road, Royapettah, Chennai 600014, Tamil Nadu
BRAND_MAPS_URL=https://maps.google.com/?q=Dadha+Chambers,+V.P.+Raman+Road,+Royapettah,+Chennai+600014
